#!/bin/bash

# eswitch - Emergency Service Switch
# Cleanly shutdown all services and restart them
# Usage: ./scripts/eswitch [start|stop|restart|status]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Project root
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

# Service configuration
BACKEND_PORT=3000
FRONTEND_PORT=5173
DB_PORT=5433
REDIS_PORT=6379

# Environment variables
export DATABASE_URL="postgresql://pivotal:pivotal@localhost:${DB_PORT}/pivotal_e2e"
export OPENAPI_ENABLE=true

log() {
    echo -e "${BLUE}[eswitch]${NC} $1"
}

success() {
    echo -e "${GREEN}[eswitch]${NC} ✅ $1"
}

warning() {
    echo -e "${YELLOW}[eswitch]${NC} ⚠️  $1"
}

error() {
    echo -e "${RED}[eswitch]${NC} ❌ $1"
}

# Function to kill processes by pattern
kill_by_pattern() {
    local pattern="$1"
    local description="$2"
    
    log "Stopping $description..."
    
    # Kill by process name pattern
    pkill -f "$pattern" 2>/dev/null || true
    
    # Wait a moment
    sleep 1
    
    # Force kill if still running
    pkill -9 -f "$pattern" 2>/dev/null || true
    
    # Verify stopped
    if pgrep -f "$pattern" >/dev/null 2>&1; then
        warning "$description processes may still be running"
        pgrep -f "$pattern" | xargs kill -9 2>/dev/null || true
    else
        success "$description stopped"
    fi
}

# Function to kill processes by port
kill_by_port() {
    local port="$1"
    local description="$2"
    
    log "Freeing port $port ($description)..."
    
    if lsof -ti:$port >/dev/null 2>&1; then
        lsof -ti:$port | xargs kill -9 2>/dev/null || true
        sleep 1
        
        if lsof -ti:$port >/dev/null 2>&1; then
            warning "Port $port may still be in use"
        else
            success "Port $port freed"
        fi
    else
        success "Port $port already free"
    fi
}

# Function to stop all services
stop_services() {
    log "🛑 EMERGENCY SHUTDOWN - Stopping all services..."
    
    # Stop by process patterns
    kill_by_pattern "backend.*dev" "Backend development servers"
    kill_by_pattern "frontend.*dev" "Frontend development servers"
    kill_by_pattern "tsx.*watch" "TypeScript watch processes"
    kill_by_pattern "pnpm.*dev" "PNPM development processes"
    kill_by_pattern "vite.*dev" "Vite development servers"
    kill_by_pattern "storybook" "Storybook servers"
    
    # Stop by ports
    kill_by_port $BACKEND_PORT "Backend API"
    kill_by_port $FRONTEND_PORT "Frontend Dev Server"
    
    # Additional cleanup
    log "Performing additional cleanup..."
    ps aux | grep -E "(backend|frontend|tsx|pnpm|vite).*dev" | grep -v grep | awk '{print $2}' | xargs kill -9 2>/dev/null || true
    
    # Wait for processes to fully terminate
    sleep 2
    
    success "🛑 All services stopped"
}

# Function to check if a service is running
check_service() {
    local port="$1"
    local name="$2"
    local url="$3"
    
    if lsof -ti:$port >/dev/null 2>&1; then
        if curl -s --max-time 3 "$url" >/dev/null 2>&1; then
            success "$name is running and responding on port $port"
            return 0
        else
            warning "$name port $port is occupied but not responding"
            return 1
        fi
    else
        error "$name is not running on port $port"
        return 1
    fi
}

# Function to wait for service to be ready
wait_for_service() {
    local port="$1"
    local name="$2"
    local url="$3"
    local max_attempts=30
    local attempt=1
    
    log "Waiting for $name to be ready..."
    
    while [ $attempt -le $max_attempts ]; do
        if curl -s --max-time 2 "$url" >/dev/null 2>&1; then
            success "$name is ready (attempt $attempt)"
            return 0
        fi
        
        if [ $((attempt % 5)) -eq 0 ]; then
            log "$name not ready yet (attempt $attempt/$max_attempts)..."
        fi
        
        sleep 1
        attempt=$((attempt + 1))
    done
    
    error "$name failed to start after $max_attempts attempts"
    return 1
}

# Function to start backend
start_backend() {
    log "🚀 Starting backend..."
    
    cd "$PROJECT_ROOT"
    
    # Start backend in background
    DATABASE_URL="$DATABASE_URL" OPENAPI_ENABLE=true pnpm --filter @pivotal-flow/backend dev > /tmp/backend.log 2>&1 &
    BACKEND_PID=$!
    
    # Wait for backend to be ready
    if wait_for_service $BACKEND_PORT "Backend" "http://localhost:$BACKEND_PORT/"; then
        success "Backend started successfully (PID: $BACKEND_PID)"
        echo $BACKEND_PID > /tmp/backend.pid
        return 0
    else
        error "Backend failed to start"
        kill $BACKEND_PID 2>/dev/null || true
        return 1
    fi
}

# Function to start frontend
start_frontend() {
    log "🚀 Starting frontend..."
    
    cd "$PROJECT_ROOT"
    
    # Start frontend in background
    pnpm --filter @pivotal-flow/frontend dev > /tmp/frontend.log 2>&1 &
    FRONTEND_PID=$!
    
    # Wait for frontend to be ready
    if wait_for_service $FRONTEND_PORT "Frontend" "http://localhost:$FRONTEND_PORT/"; then
        success "Frontend started successfully (PID: $FRONTEND_PID)"
        echo $FRONTEND_PID > /tmp/frontend.pid
        return 0
    else
        error "Frontend failed to start"
        kill $FRONTEND_PID 2>/dev/null || true
        return 1
    fi
}

# Function to start all services
start_services() {
    log "🚀 EMERGENCY STARTUP - Starting all services..."
    
    # Ensure we're in the project root
    cd "$PROJECT_ROOT"
    
    # Start backend first
    if start_backend; then
        log "Backend startup complete"
    else
        error "Backend startup failed"
        return 1
    fi
    
    # Start frontend
    if start_frontend; then
        log "Frontend startup complete"
    else
        error "Frontend startup failed"
        return 1
    fi
    
    success "🚀 All services started successfully"
    show_status
}

# Function to show service status
show_status() {
    log "📊 SERVICE STATUS:"
    echo
    
    # Check backend
    if check_service $BACKEND_PORT "Backend API" "http://localhost:$BACKEND_PORT/"; then
        log "   Backend logs: tail -f /tmp/backend.log"
    fi
    
    # Check frontend  
    if check_service $FRONTEND_PORT "Frontend Dev" "http://localhost:$FRONTEND_PORT/"; then
        log "   Frontend logs: tail -f /tmp/frontend.log"
    fi
    
    echo
    log "🌐 Application URLs:"
    log "   Frontend: http://localhost:$FRONTEND_PORT"
    log "   Backend API: http://localhost:$BACKEND_PORT"
    log "   API Docs: http://localhost:$BACKEND_PORT/docs"
    
    echo
    log "🔧 Useful commands:"
    log "   Stop all: ./scripts/eswitch stop"
    log "   Restart: ./scripts/eswitch restart"
    log "   Status: ./scripts/eswitch status"
}

# Function to restart services
restart_services() {
    log "🔄 EMERGENCY RESTART - Full service restart..."
    stop_services
    sleep 3
    start_services
}

# Main script logic
case "${1:-restart}" in
    "stop")
        stop_services
        ;;
    "start")
        start_services
        ;;
    "restart")
        restart_services
        ;;
    "status")
        show_status
        ;;
    *)
        echo "Usage: $0 [start|stop|restart|status]"
        echo
        echo "Emergency service management for Pivotal Flow development"
        echo
        echo "Commands:"
        echo "  start   - Start all services cleanly"
        echo "  stop    - Stop all services and free ports"
        echo "  restart - Stop then start all services (default)"
        echo "  status  - Show current service status"
        exit 1
        ;;
esac
