#!/bin/bash

# estart - Emergency Service Start
# Cleanly shutdown all services and restart them with Redis support
# Usage: ./scripts/estart [start|stop|restart|status] [-v|--verbose]

set -e

# Verbose mode flag
VERBOSE_MODE=false

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose)
            VERBOSE_MODE=true
            shift
            ;;
        -h|--help)
            COMMAND="help"
            shift
            ;;
        start|stop|restart|status)
            COMMAND="$1"
            shift
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use -h or --help for usage information"
            exit 1
            ;;
    esac
done

# Default command if none provided
COMMAND="${COMMAND:-restart}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Project root
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

# Logging configuration
LOG_DIR="$PROJECT_ROOT/logs"
ESWITCH_LOG="$LOG_DIR/eswitch.log"
LOG_MAX_SIZE=10485760  # 10MB
LOG_MAX_FILES=5

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Initialize log file with session header
init_log_session() {
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "================================================" >> "$ESWITCH_LOG"
    echo "ESWITCH SESSION STARTED - $timestamp" >> "$ESWITCH_LOG"
    echo "Command: $0 $*" >> "$ESWITCH_LOG"
    echo "Verbose Mode: $VERBOSE_MODE" >> "$ESWITCH_LOG"
    echo "PID: $$" >> "$ESWITCH_LOG"
    echo "Working Directory: $(pwd)" >> "$ESWITCH_LOG"
    echo "User: $(whoami)" >> "$ESWITCH_LOG"
    echo "Host: $(hostname)" >> "$ESWITCH_LOG"
    echo "System: $(uname -a)" >> "$ESWITCH_LOG"
    echo "Shell: $SHELL" >> "$ESWITCH_LOG"
    echo "Bash Version: $BASH_VERSION" >> "$ESWITCH_LOG"
    echo "================================================" >> "$ESWITCH_LOG"
    
    # Verbose mode initialization
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Eswitch started in verbose mode"
        verbose "Command: $0 $*"
        verbose "Working directory: $(pwd)"
        verbose "User: $(whoami)"
        verbose "Host: $(hostname)"
        verbose "System: $(uname -a)"
        verbose "Shell: $SHELL"
        verbose "Bash version: $BASH_VERSION"
        verbose "Current environment variables:"
        env | grep -E '(DATABASE_URL|REDIS_URL|NODE_ENV|PORT|HOST|CORS_ORIGIN|JWT_SECRET|OPENAPI_ENABLE)' | sort | while read line; do
            verbose "  $line"
        done
    fi
}

# Log rotation function
rotate_logs() {
    if [ -f "$ESWITCH_LOG" ] && [ $(stat -f%z "$ESWITCH_LOG" 2>/dev/null || stat -c%s "$ESWITCH_LOG" 2>/dev/null) -gt $LOG_MAX_SIZE ]; then
        local timestamp=$(date '+%Y%m%d_%H%M%S')
        
        # Rotate existing logs
        for i in $(seq $((LOG_MAX_FILES-1)) -1 1); do
            if [ -f "${ESWITCH_LOG}.$i" ]; then
                mv "${ESWITCH_LOG}.$i" "${ESWITCH_LOG}.$((i+1))"
            fi
        done
        
        # Move current log
        if [ -f "$ESWITCH_LOG" ]; then
            mv "$ESWITCH_LOG" "${ESWITCH_LOG}.1"
        fi
        
        # Create new log file
        touch "$ESWITCH_LOG"
        echo "Log rotated at $(date '+%Y-%m-%d %H:%M:%S')" >> "$ESWITCH_LOG"
    fi
}

# Enhanced logging function with multiple outputs
log_message() {
    local level="$1"
    local message="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S.%3N')
    local log_entry="[$timestamp] [$level] $message"
    
    # Console output with colors
    case "$level" in
        "DEBUG")
            if [ "$VERBOSE_MODE" = true ]; then
                echo -e "${PURPLE}[DEBUG]${NC} $message" >&2
            fi
            ;;
        "INFO")
            echo -e "${BLUE}[INFO]${NC} $message"
            ;;
        "SUCCESS")
            echo -e "${GREEN}[SUCCESS]${NC} ✅ $message"
            ;;
        "WARNING")
            echo -e "${YELLOW}[WARNING]${NC} ⚠️  $message"
            ;;
        "ERROR")
            echo -e "${RED}[ERROR]${NC} ❌ $message"
            ;;
        "PERF")
            if [ "$VERBOSE_MODE" = true ]; then
                echo -e "${CYAN}[PERF]${NC} ⏱️  $message"
            fi
            ;;
        "VERBOSE")
            if [ "$VERBOSE_MODE" = true ]; then
                echo -e "${BLUE}[VERBOSE]${NC} 🔍 $message"
            fi
            ;;
        *)
            echo -e "${BLUE}[eswitch]${NC} $message"
            ;;
    esac
    
    # File output (always log to file regardless of verbose mode)
    echo "$log_entry" >> "$ESWITCH_LOG"
}

# Performance timing functions
declare -A START_TIMES

start_timer() {
    local operation="$1"
    START_TIMES["$operation"]=$(date +%s.%3N)
    log_message "PERF" "Started: $operation"
}

end_timer() {
    local operation="$1"
    local start_time="${START_TIMES[$operation]}"
    if [ -n "$start_time" ]; then
        local end_time=$(date +%s.%3N)
        local duration=$(echo "$end_time - $start_time" | bc -l 2>/dev/null || echo "N/A")
        log_message "PERF" "Completed: $operation (${duration}s)"
        unset START_TIMES["$operation"]
    fi
}

# Enhanced error logging with context
log_error() {
    local message="$1"
    local error_code="${2:-1}"
    local context="${3:-}"
    
    log_message "ERROR" "$message"
    
    # Add context if provided
    if [ -n "$context" ]; then
        log_message "ERROR" "Context: $context"
    fi
    
    # Add stack trace for debugging
    log_message "DEBUG" "Error occurred in function: ${FUNCNAME[1]}"
    log_message "DEBUG" "Call stack: ${FUNCNAME[*]}"
    
    # Log system information
    log_message "DEBUG" "System: $(uname -a)"
    log_message "DEBUG" "Memory usage: $(free -h 2>/dev/null || echo 'N/A')"
    log_message "DEBUG" "Disk usage: $(df -h . 2>/dev/null | tail -1 || echo 'N/A')"
    
    return $error_code
}

# Define logging functions first
debug() {
    log_message "DEBUG" "$1"
}

info() {
    log_message "INFO" "$1"
}

verbose() {
    log_message "VERBOSE" "$1"
}

# Enhanced verbose logging for command execution
log_command() {
    local cmd="$1"
    local description="${2:-Command execution}"
    
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Executing: $description"
        verbose "Command: $cmd"
        verbose "Working directory: $(pwd)"
        verbose "Environment: $(env | grep -E '(DATABASE_URL|REDIS_URL|NODE_ENV|PORT|HOST)' | sort)"
    fi
}

# Initialize logging for this session
rotate_logs
init_log_session "$@"

# Service configuration
BACKEND_PORT=3000
FRONTEND_PORT=5173
DB_PORT=5433
REDIS_PORT=6379

# Environment variables
export DATABASE_URL="postgresql://pivotal:pivotal@localhost:${DB_PORT}/pivotal_e2e"
export OPENAPI_ENABLE=true

# Legacy logging functions for backward compatibility
log() {
    log_message "INFO" "$1"
}

success() {
    log_message "SUCCESS" "$1"
}

warning() {
    log_message "WARNING" "$1"
}

error() {
    log_message "ERROR" "$1"
}

# Additional logging functions (legacy compatibility)
# Functions are now defined earlier in the script

# Function to kill processes by pattern
kill_by_pattern() {
    local pattern="$1"
    local description="$2"
    
    start_timer "kill_pattern_$description"
    log "Stopping $description..."
    debug "Searching for processes matching pattern: $pattern"
    
    # Find processes before killing
    local pids=$(pgrep -f "$pattern" 2>/dev/null || echo "")
    if [ -n "$pids" ]; then
        debug "Found processes to kill: $pids"
        log "Found $(echo $pids | wc -w) $description processes"
        
        # Verbose process details
        if [ "$VERBOSE_MODE" = true ]; then
            verbose "Detailed process information for $description:"
            for pid in $pids; do
                local process_info=$(ps -p $pid -o pid,ppid,user,cmd --no-headers 2>/dev/null || echo "Process $pid not found")
                verbose "  PID $pid: $process_info"
            done
        fi
    else
        debug "No processes found matching pattern: $pattern"
        log "No $description processes found"
        end_timer "kill_pattern_$description"
        return 0
    fi
    
    # Kill by process name pattern
    debug "Attempting graceful kill with SIGTERM"
    if pkill -f "$pattern" 2>/dev/null; then
        debug "SIGTERM sent to $description processes"
    fi
    
    # Wait a moment
    sleep 1
    
    # Check if still running
    local remaining=$(pgrep -f "$pattern" 2>/dev/null || echo "")
    if [ -n "$remaining" ]; then
        debug "Processes still running after SIGTERM: $remaining"
        warning "Force killing remaining $description processes"
        
        # Force kill if still running
        if pkill -9 -f "$pattern" 2>/dev/null; then
            debug "SIGKILL sent to remaining processes"
        fi
    fi
    
    # Verify stopped
    local final_check=$(pgrep -f "$pattern" 2>/dev/null || echo "")
    if [ -n "$final_check" ]; then
        warning "$description processes may still be running: $final_check"
        debug "Attempting final force kill"
        echo "$final_check" | xargs kill -9 2>/dev/null || true
        end_timer "kill_pattern_$description"
        return 1
    else
        success "$description stopped successfully"
        end_timer "kill_pattern_$description"
        return 0
    fi
}

# Function to kill processes by port
kill_by_port() {
    local port="$1"
    local description="$2"
    
    start_timer "kill_port_$port"
    log "Freeing port $port ($description)..."
    
    # Check what's using the port
    local port_info=$(lsof -i:$port 2>/dev/null || echo "")
    if [ -n "$port_info" ]; then
        debug "Port $port is in use:"
        debug "$port_info"
        
        local pids=$(lsof -ti:$port 2>/dev/null || echo "")
        if [ -n "$pids" ]; then
            debug "Killing processes using port $port: $pids"
            echo "$pids" | xargs kill -9 2>/dev/null || true
            sleep 1
            
            # Verify port is free
            if lsof -ti:$port >/dev/null 2>&1; then
                warning "Port $port may still be in use after force kill"
                debug "Remaining processes on port $port: $(lsof -ti:$port 2>/dev/null || echo 'none')"
                end_timer "kill_port_$port"
                return 1
            else
                success "Port $port freed successfully"
                end_timer "kill_port_$port"
                return 0
            fi
        fi
    else
        debug "Port $port is already free"
        success "Port $port already free"
        end_timer "kill_port_$port"
        return 0
    fi
}

# Function to stop all services
stop_services() {
    start_timer "stop_all_services"
    log "🛑 EMERGENCY SHUTDOWN - Stopping all services..."
    debug "Current system state before shutdown:"
    debug "Memory: $(free -h 2>/dev/null | head -2 || echo 'N/A')"
    debug "Load: $(uptime 2>/dev/null || echo 'N/A')"
    
    # Log current processes before stopping
    debug "Current development processes:"
    ps aux | grep -E "(backend|frontend|tsx|pnpm|vite|storybook)" | grep -v grep | while read line; do
        debug "  $line"
    done
    
    # Stop by process patterns
    local stop_failed=false
    
    debug "Stopping services by process pattern..."
    kill_by_pattern "backend.*dev" "Backend development servers" || stop_failed=true
    kill_by_pattern "frontend.*dev" "Frontend development servers" || stop_failed=true
    kill_by_pattern "tsx.*watch" "TypeScript watch processes" || stop_failed=true
    kill_by_pattern "pnpm.*dev" "PNPM development processes" || stop_failed=true
    kill_by_pattern "vite.*dev" "Vite development servers" || stop_failed=true
    kill_by_pattern "storybook" "Storybook servers" || stop_failed=true
    
    # Stop by ports
    debug "Stopping services by port..."
    kill_by_port $BACKEND_PORT "Backend API" || stop_failed=true
    kill_by_port $FRONTEND_PORT "Frontend Dev Server" || stop_failed=true
    
    # Additional cleanup
    log "Performing additional cleanup..."
    debug "Searching for remaining development processes..."
    local remaining_processes=$(ps aux | grep -E "(backend|frontend|tsx|pnpm|vite).*dev" | grep -v grep || echo "")
    if [ -n "$remaining_processes" ]; then
        debug "Found remaining processes for cleanup:"
        echo "$remaining_processes" | while read line; do
            debug "  $line"
        done
        echo "$remaining_processes" | awk '{print $2}' | xargs kill -9 2>/dev/null || true
    else
        debug "No remaining processes found for cleanup"
    fi
    
    # Wait for processes to fully terminate
    debug "Waiting for processes to fully terminate..."
    sleep 2
    
    # Final verification
    debug "Final process verification:"
    local final_check=$(ps aux | grep -E "(backend|frontend|tsx|pnpm|vite|storybook)" | grep -v grep || echo "")
    if [ -n "$final_check" ]; then
        warning "Some processes may still be running:"
        echo "$final_check" | while read line; do
            warning "  $line"
        done
        stop_failed=true
    else
        debug "All development processes successfully terminated"
    fi
    
    end_timer "stop_all_services"
    
    if [ "$stop_failed" = true ]; then
        warning "🛑 Service shutdown completed with warnings"
        return 1
    else
        success "🛑 All services stopped successfully"
        return 0
    fi
}

# Function to check if a service is running
check_service() {
    local port="$1"
    local name="$2"
    local url="$3"
    
    if lsof -ti:$port >/dev/null 2>&1; then
        if curl -s --max-time 3 "$url" >/dev/null 2>&1; then
            success "$name is running and responding on port $port"
            return 0
        else
            warning "$name port $port is occupied but not responding"
            return 1
        fi
    else
        error "$name is not running on port $port"
        return 1
    fi
}

# Function to wait for service to be ready
wait_for_service() {
    local port="$1"
    local name="$2"
    local url="$3"
    local max_attempts=30
    local attempt=1
    
    log "Waiting for $name to be ready..."
    
    while [ $attempt -le $max_attempts ]; do
        if curl -s --max-time 2 "$url" >/dev/null 2>&1; then
            success "$name is ready (attempt $attempt)"
            return 0
        fi
        
        if [ $((attempt % 5)) -eq 0 ]; then
            log "$name not ready yet (attempt $attempt/$max_attempts)..."
        fi
        
        sleep 1
        attempt=$((attempt + 1))
    done
    
    error "$name failed to start after $max_attempts attempts"
    return 1
}

# Function to setup environment (from startup script)
setup_environment() {
    log "🔧 Setting up environment..."
    
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Setting up development environment variables"
    fi
    
    export DATABASE_URL="postgresql://pivotal:pivotal@localhost:5433/pivotal_e2e"
    export REDIS_URL="redis://localhost:6379"
    export JWT_SECRET="your-super-secret-jwt-key-that-is-at-least-32-characters-long"
    export CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:5174"
    export OPENAPI_ENABLE="true"
    export ALLOW_LOCAL_DB_CREATION="yes"
    export NODE_ENV="development"
    export PORT="3000"
    export HOST="localhost"
    
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Environment variables set:"
        verbose "  DATABASE_URL: $DATABASE_URL"
        verbose "  REDIS_URL: $REDIS_URL"
        verbose "  JWT_SECRET: [HIDDEN]"
        verbose "  CORS_ORIGIN: $CORS_ORIGIN"
        verbose "  OPENAPI_ENABLE: $OPENAPI_ENABLE"
        verbose "  ALLOW_LOCAL_DB_CREATION: $ALLOW_LOCAL_DB_CREATION"
        verbose "  NODE_ENV: $NODE_ENV"
        verbose "  PORT: $PORT"
        verbose "  HOST: $HOST"
    fi
    
    success "Environment variables configured"
}

# Function to start Docker services with improved Redis handling
start_docker_services() {
    log "🐳 Starting Docker services..."
    
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Changing to Docker directory: $PROJECT_ROOT/infra/docker"
        verbose "Checking Docker compose file..."
        if [ -f "$PROJECT_ROOT/infra/docker/docker-compose.yml" ]; then
            verbose "Docker compose file found"
        else
            warning "Docker compose file not found at expected location"
        fi
    fi
    
    cd "$PROJECT_ROOT/infra/docker"
    
    # Stop any existing containers first
    log "Stopping existing Docker containers..."
    docker compose down 2>/dev/null || true
    
    # Start services
    log_command "docker compose up -d" "Starting Docker services"
    docker compose up -d
    cd "$PROJECT_ROOT"
    
    log "Waiting for Docker services to initialize..."
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Waiting 15 seconds for Docker services to start up"
        verbose "Checking Docker container status..."
        docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | while read line; do
            verbose "  $line"
        done
    fi
    sleep 15
    
    # Check PostgreSQL with retries
    log "Checking PostgreSQL connection..."
    local pg_attempts=0
    local pg_max_attempts=10
    while [ $pg_attempts -lt $pg_max_attempts ]; do
        if docker exec docker-postgres-1 pg_isready -U pivotal -d pivotal_e2e >/dev/null 2>&1; then
            success "PostgreSQL is ready"
            break
        else
            pg_attempts=$((pg_attempts + 1))
            if [ $pg_attempts -lt $pg_max_attempts ]; then
                log "PostgreSQL not ready yet (attempt $pg_attempts/$pg_max_attempts)..."
                sleep 2
            else
                error "PostgreSQL failed to start after $pg_max_attempts attempts"
                return 1
            fi
        fi
    done
    
    # Check Redis with retries and improved error handling
    log "Checking Redis connection..."
    local redis_attempts=0
    local redis_max_attempts=10
    while [ $redis_attempts -lt $redis_max_attempts ]; do
        if docker exec docker-redis-1 redis-cli ping >/dev/null 2>&1; then
            success "Redis is ready"
            break
        else
            redis_attempts=$((redis_attempts + 1))
            if [ $redis_attempts -lt $redis_max_attempts ]; then
                log "Redis not ready yet (attempt $redis_attempts/$redis_max_attempts)..."
                sleep 2
            else
                error "Redis failed to start after $redis_max_attempts attempts"
                log "Redis container logs:"
                docker logs docker-redis-1 --tail 20 2>/dev/null || true
                return 1
            fi
        fi
    done
    
    # Additional Redis health check
    log "Performing Redis health check..."
    if docker exec docker-redis-1 redis-cli set test:estart:health "ok" >/dev/null 2>&1; then
        if docker exec docker-redis-1 redis-cli get test:estart:health >/dev/null 2>&1 | grep -q "ok"; then
            docker exec docker-redis-1 redis-cli del test:estart:health >/dev/null 2>&1
            success "Redis read/write test passed"
        else
            warning "Redis read/write test failed"
            return 1
        fi
    else
        warning "Redis read/write test failed"
        return 1
    fi
    
    success "Docker services are running and healthy"
}

# Function to setup database (from startup script)
setup_database() {
    log "🗄️ Setting up database..."
    
    log "Generating database schema..."
    if pnpm --filter backend drizzle:generate; then
        success "Database schema generated"
    else
        error "Failed to generate database schema"
        return 1
    fi
    
    log "Pushing database schema..."
    if DATABASE_URL="$DATABASE_URL" ALLOW_LOCAL_DB_CREATION=yes pnpm --filter backend drizzle:push; then
        success "Database schema pushed successfully"
    else
        warning "Database schema push failed - this may be normal if schema already exists"
    fi
    
    log "Seeding database with demo data..."
    if DATABASE_URL="$DATABASE_URL" pnpm --filter backend db:seed; then
        success "Database seeded successfully"
    else
        error "Failed to seed database"
        return 1
    fi
}

# Function to start backend (from startup script)
start_backend() {
    log "🚀 Starting backend server..."
    
    # Kill any existing backend processes
    kill_by_port $BACKEND_PORT "Backend"
    
    # Create logs directory
    mkdir -p logs
    touch logs/backend.log
    
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Backend startup details:"
        verbose "  Backend directory: $PROJECT_ROOT/apps/backend"
        verbose "  Log file: $PROJECT_ROOT/logs/backend.log"
        verbose "  PID file: $PROJECT_ROOT/logs/backend.pid"
        verbose "  Port: $BACKEND_PORT"
    fi
    
    cd "$PROJECT_ROOT/apps/backend"
    
    # Start backend in background (exact command from startup script)
    log_command "nohup pnpm dev > ../../logs/backend.log 2>&1 &" "Starting backend server"
    nohup pnpm dev > ../../logs/backend.log 2>&1 &
    BACKEND_PID=$!
    echo $BACKEND_PID > ../../logs/backend.pid
    
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Backend started with PID: $BACKEND_PID"
        verbose "Backend PID saved to: $PROJECT_ROOT/logs/backend.pid"
        verbose "Backend logs will be written to: $PROJECT_ROOT/logs/backend.log"
    fi
    
    cd "$PROJECT_ROOT"
    
    # Wait for backend to be ready (using startup script health endpoint)
    if wait_for_service $BACKEND_PORT "Backend" "http://localhost:$BACKEND_PORT/"; then
        success "Backend started successfully (PID: $BACKEND_PID)"
        return 0
    else
        error "Backend failed to start"
        error "Check logs: tail -f logs/backend.log"
        kill $BACKEND_PID 2>/dev/null || true
        return 1
    fi
}

# Function to start frontend (from startup script)
start_frontend() {
    log "🌐 Starting frontend server..."
    
    # Kill any existing frontend processes
    kill_by_port $FRONTEND_PORT "Frontend"
    
    # Create logs directory
    mkdir -p logs
    touch logs/frontend.log
    
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Frontend startup details:"
        verbose "  Frontend directory: $PROJECT_ROOT/apps/frontend"
        verbose "  Log file: $PROJECT_ROOT/logs/frontend.log"
        verbose "  PID file: $PROJECT_ROOT/logs/frontend.pid"
        verbose "  Port: $FRONTEND_PORT"
    fi
    
    cd "$PROJECT_ROOT/apps/frontend"
    
    # Start frontend in background (exact command from startup script)
    log_command "nohup pnpm dev > ../../logs/frontend.log 2>&1 &" "Starting frontend server"
    nohup pnpm dev > ../../logs/frontend.log 2>&1 &
    FRONTEND_PID=$!
    echo $FRONTEND_PID > ../../logs/frontend.pid
    
    if [ "$VERBOSE_MODE" = true ]; then
        verbose "Frontend started with PID: $FRONTEND_PID"
        verbose "Frontend PID saved to: $PROJECT_ROOT/logs/frontend.pid"
        verbose "Frontend logs will be written to: $PROJECT_ROOT/logs/frontend.log"
    fi
    
    cd "$PROJECT_ROOT"
    
    # Wait for frontend to be ready
    if wait_for_service $FRONTEND_PORT "Frontend" "http://localhost:$FRONTEND_PORT/"; then
        success "Frontend started successfully (PID: $FRONTEND_PID)"
        return 0
    else
        error "Frontend failed to start"
        error "Check logs: tail -f logs/frontend.log"
        kill $FRONTEND_PID 2>/dev/null || true
        return 1
    fi
}

# Function to start all services (using startup script sequence)
start_services() {
    start_timer "start_all_services"
    log "🚀 EMERGENCY STARTUP - Starting all services..."
    debug "Starting service startup sequence"
    debug "Project root: $PROJECT_ROOT"
    debug "Current working directory: $(pwd)"
    
    # Ensure we're in the project root
    cd "$PROJECT_ROOT"
    debug "Changed to project root: $(pwd)"
    
    local startup_failed=false
    
    # Follow exact startup script sequence
    debug "Phase 1: Setting up environment"
    if setup_environment; then
        success "Environment setup completed"
    else
        error "Environment setup failed"
        startup_failed=true
    fi
    
    # Start Docker services
    debug "Phase 2: Starting Docker services"
    if start_docker_services; then
        success "Docker services ready"
    else
        error "Docker services failed"
        startup_failed=true
    fi
    
    # Skip database setup for emergency restart (already configured)
    debug "Phase 3: Database setup (skipped for emergency restart)"
    log "Skipping database setup (using existing schema)"
    
    # Start backend
    debug "Phase 4: Starting backend service"
    if start_backend; then
        success "Backend startup complete"
    else
        error "Backend startup failed"
        startup_failed=true
    fi
    
    # Start frontend
    debug "Phase 5: Starting frontend service"
    if start_frontend; then
        success "Frontend startup complete"
    else
        error "Frontend startup failed"
        startup_failed=true
    fi
    
    # Run health checks
    debug "Phase 6: Running health checks"
    if run_health_checks; then
        success "Health checks completed"
    else
        warning "Health checks failed"
        startup_failed=true
    fi
    
    end_timer "start_all_services"
    
    if [ "$startup_failed" = true ]; then
        error "🚀 Service startup completed with errors"
        show_status
        return 1
    else
        success "🚀 All services started successfully"
        show_status
        return 0
    fi
}

# Function to run health checks (from startup script)
run_health_checks() {
    start_timer "health_checks"
    log "🔍 Running health checks..."
    local health_failed=false
    
    # Backend health check
    debug "Testing backend health endpoint..."
    log "Testing backend health endpoint..."
    local backend_health_response=$(curl -s --max-time 10 "http://localhost:3000/api/v1/health" 2>/dev/null || echo "")
    if [ -n "$backend_health_response" ] && echo "$backend_health_response" | grep -q "status"; then
        success "Backend health check passed"
        debug "Backend health response: $backend_health_response"
    else
        warning "Backend health check failed"
        debug "Backend health response: $backend_health_response"
        health_failed=true
    fi
    
    # Frontend accessibility check
    debug "Testing frontend accessibility..."
    log "Testing frontend accessibility..."
    local frontend_response=$(curl -s --max-time 10 "http://localhost:5173" 2>/dev/null || echo "")
    if [ -n "$frontend_response" ] && echo "$frontend_response" | grep -q "html"; then
        success "Frontend accessibility check passed"
        debug "Frontend responded with HTML content"
    else
        warning "Frontend accessibility check failed"
        debug "Frontend response: ${frontend_response:0:200}..."
        health_failed=true
    fi
    
    # Login functionality test
    debug "Testing login functionality..."
    log "Testing login functionality..."
    sleep 3
    
    local login_start=$(date +%s.%3N)
    LOGIN_RESPONSE=$(curl -s -X POST http://localhost:3000/api/v1/auth/login-opaque \
        -H "Content-Type: application/json" \
        -d '{"email":"admin@pivotalflow.com","password":"password123!extra"}' \
        --connect-timeout 10 --max-time 15 2>/dev/null || echo "")
    local login_end=$(date +%s.%3N)
    local login_duration=$(echo "$login_end - $login_start" | bc -l 2>/dev/null || echo "N/A")
    
    debug "Login request completed in ${login_duration}s"
    debug "Login response: $LOGIN_RESPONSE"
    
    if [ -n "$LOGIN_RESPONSE" ] && echo "$LOGIN_RESPONSE" | grep -q "accessToken"; then
        success "Login test passed! (${login_duration}s)"
        success "🔑 Login credentials: admin@pivotalflow.com / password123!extra"
        
        # Test Redis session storage for PASETO tokens
        debug "Testing Redis session storage..."
        log "Testing Redis session storage..."
        
        # Extract access token for session testing
        local access_token=$(echo "$LOGIN_RESPONSE" | grep -o '"accessToken":"[^"]*"' | cut -d'"' -f4)
        if [ -n "$access_token" ]; then
            # Test API call with PASETO token
            local api_response=$(curl -s -H "Authorization: Bearer $access_token" \
                "http://localhost:3000/api/v1/auth/me" \
                --connect-timeout 5 --max-time 10 2>/dev/null || echo "")
            
            if [ -n "$api_response" ] && echo "$api_response" | grep -q "id"; then
                success "PASETO session validation passed"
                debug "PASETO token type: $(echo "$access_token" | head -c 20)..."
            else
                warning "PASETO session validation failed"
                debug "API response: ${api_response:0:200}..."
                health_failed=true
            fi
        else
            warning "Could not extract access token for session testing"
            health_failed=true
        fi
    else
        warning "Login test failed. Response: $LOGIN_RESPONSE"
        health_failed=true
    fi
    
    # Redis connectivity test for PASETO sessions
    debug "Testing Redis connectivity for PASETO..."
    log "Testing Redis connectivity for PASETO..."
    
    if docker exec docker-redis-1 redis-cli ping >/dev/null 2>&1; then
        # Test Redis session operations
        local test_key="test:session:$(date +%s)"
        local test_value='{"userId":"test","sessionId":"test-session"}'
        
        if docker exec docker-redis-1 redis-cli setex "$test_key" 60 "$test_value" >/dev/null 2>&1; then
            local retrieved_value=$(docker exec docker-redis-1 redis-cli get "$test_key" 2>/dev/null || echo "")
            if [ "$retrieved_value" = "$test_value" ]; then
                success "Redis session storage test passed"
                # Clean up test key
                docker exec docker-redis-1 redis-cli del "$test_key" >/dev/null 2>&1
            else
                warning "Redis session retrieval failed"
                debug "Expected: $test_value"
                debug "Got: $retrieved_value"
                health_failed=true
            fi
        else
            warning "Redis session storage test failed"
            health_failed=true
        fi
    else
        error "Redis connectivity test failed - PASETO sessions will not work"
        health_failed=true
    fi
    
    # Additional service checks
    debug "Running additional service checks..."
    
    # Check if ports are properly bound
    local backend_port_check=$(lsof -i:$BACKEND_PORT 2>/dev/null || echo "")
    local frontend_port_check=$(lsof -i:$FRONTEND_PORT 2>/dev/null || echo "")
    
    if [ -n "$backend_port_check" ]; then
        debug "Backend port $BACKEND_PORT is properly bound"
    else
        warning "Backend port $BACKEND_PORT is not bound"
        health_failed=true
    fi
    
    if [ -n "$frontend_port_check" ]; then
        debug "Frontend port $FRONTEND_PORT is properly bound"
    else
        warning "Frontend port $FRONTEND_PORT is not bound"
        health_failed=true
    fi
    
    end_timer "health_checks"
    
    if [ "$health_failed" = true ]; then
        warning "🔍 Health checks completed with failures"
        return 1
    else
        success "🔍 All health checks passed"
        return 0
    fi
}

# Function to show service status
show_status() {
    start_timer "show_status"
    log "📊 SERVICE STATUS:"
    echo
    
    debug "Gathering detailed service status information"
    
    # System information
    debug "System Information:"
    debug "  Uptime: $(uptime 2>/dev/null || echo 'N/A')"
    debug "  Memory: $(free -h 2>/dev/null | head -2 || echo 'N/A')"
    debug "  Disk: $(df -h . 2>/dev/null | tail -1 || echo 'N/A')"
    debug "  Load: $(cat /proc/loadavg 2>/dev/null || echo 'N/A')"
    
    # Check backend
    log "🔧 Backend Service:"
    if check_service $BACKEND_PORT "Backend API" "http://localhost:$BACKEND_PORT/"; then
        local backend_pid=$(lsof -ti:$BACKEND_PORT 2>/dev/null || echo "")
        local backend_process=$(ps -p $backend_pid -o pid,ppid,cmd --no-headers 2>/dev/null || echo "")
        debug "Backend process: $backend_process"
        log "   Backend logs: tail -f $LOG_DIR/backend.log"
        log "   Backend PID file: $LOG_DIR/backend.pid"
    else
        warning "Backend service is not running"
    fi
    
    # Check frontend  
    log "🌐 Frontend Service:"
    if check_service $FRONTEND_PORT "Frontend Dev" "http://localhost:$FRONTEND_PORT/"; then
        local frontend_pid=$(lsof -ti:$FRONTEND_PORT 2>/dev/null || echo "")
        local frontend_process=$(ps -p $frontend_pid -o pid,ppid,cmd --no-headers 2>/dev/null || echo "")
        debug "Frontend process: $frontend_process"
        log "   Frontend logs: tail -f $LOG_DIR/frontend.log"
        log "   Frontend PID file: $LOG_DIR/frontend.pid"
    else
        warning "Frontend service is not running"
    fi
    
    # Docker services status
    log "🐳 Docker Services:"
    if command -v docker >/dev/null 2>&1; then
        local docker_status=$(docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | grep -E "(postgres|redis)" || echo "No Docker services found")
        debug "Docker services: $docker_status"
        echo "$docker_status" | while read line; do
            log "   $line"
        done
    else
        warning "Docker not available"
    fi
    
    echo
    log "🌐 Application URLs:"
    log "   Frontend: http://localhost:$FRONTEND_PORT"
    log "   Backend API: http://localhost:$BACKEND_PORT"
    log "   API Docs: http://localhost:$BACKEND_PORT/docs"
    log "   Health Check: http://localhost:$BACKEND_PORT/api/v1/health"
    
    echo
    log "📋 Log Files:"
    log "   Eswitch Log: $ESWITCH_LOG"
    log "   Backend Log: $LOG_DIR/backend.log"
    log "   Frontend Log: $LOG_DIR/frontend.log"
    
    echo
    log "🔧 Useful commands:"
    log "   Stop all: ./scripts/eswitch stop"
    log "   Restart: ./scripts/eswitch restart"
    log "   Status: ./scripts/eswitch status"
    log "   View logs: tail -f $ESWITCH_LOG"
    if [ "$VERBOSE_MODE" = true ]; then
        log "   Verbose mode: ./scripts/eswitch [command] --verbose"
    fi
    
    # Log file sizes
    debug "Log file sizes:"
    for log_file in "$ESWITCH_LOG" "$LOG_DIR/backend.log" "$LOG_DIR/frontend.log"; do
        if [ -f "$log_file" ]; then
            local size=$(ls -lh "$log_file" 2>/dev/null | awk '{print $5}' || echo "unknown")
            debug "  $(basename "$log_file"): $size"
        fi
    done
    
    end_timer "show_status"
}

# Function to restart services
restart_services() {
    start_timer "restart_all_services"
    log "🔄 EMERGENCY RESTART - Full service restart..."
    debug "Starting full service restart sequence"
    
    local restart_failed=false
    
    # Stop services
    debug "Phase 1: Stopping all services"
    if stop_services; then
        success "Services stopped successfully"
    else
        warning "Service stop completed with warnings"
        restart_failed=true
    fi
    
    # Wait between stop and start
    debug "Phase 2: Waiting for clean shutdown"
    sleep 3
    
    # Start services
    debug "Phase 3: Starting all services"
    if start_services; then
        success "Services started successfully"
    else
        error "Service start failed"
        restart_failed=true
    fi
    
    end_timer "restart_all_services"
    
    if [ "$restart_failed" = true ]; then
        error "🔄 Service restart completed with errors"
        return 1
    else
        success "🔄 Service restart completed successfully"
        return 0
    fi
}

# Function to cleanup session logging
cleanup_session() {
    local exit_code="$1"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    echo "================================================" >> "$ESWITCH_LOG"
    echo "ESWITCH SESSION ENDED - $timestamp" >> "$ESWITCH_LOG"
    echo "Exit Code: $exit_code" >> "$ESWITCH_LOG"
    echo "Final Memory Usage: $(free -h 2>/dev/null | head -2 || echo 'N/A')" >> "$ESWITCH_LOG"
    echo "Final Load: $(uptime 2>/dev/null || echo 'N/A')" >> "$ESWITCH_LOG"
    echo "================================================" >> "$ESWITCH_LOG"
    echo "" >> "$ESWITCH_LOG"
    
    debug "Session cleanup completed"
    debug "Log file: $ESWITCH_LOG"
}

# Set up trap for cleanup on exit
trap 'cleanup_session $?' EXIT

# Main script logic
case "$COMMAND" in
    "help")
        echo "Usage: $0 [start|stop|restart|status] [-v|--verbose]"
        echo
        echo "Emergency service management for Pivotal Flow development"
        echo "Includes Docker services (PostgreSQL + Redis) with improved reliability"
        echo
        echo "Commands:"
        echo "  start   - Start all services cleanly (Docker + Backend + Frontend)"
        echo "  stop    - Stop all services and free ports"
        echo "  restart - Stop then start all services (default)"
        echo "  status  - Show current service status"
        echo
        echo "Options:"
        echo "  -v, --verbose  - Enable verbose logging with detailed debug information"
        echo "  -h, --help     - Show this help message"
        echo
        echo "Examples:"
        echo "  $0 restart              # Normal restart with standard logging"
        echo "  $0 restart --verbose    # Restart with detailed verbose logging"
        echo "  $0 status -v            # Show status with verbose process details"
        echo "  $0 --help               # Show this help message"
        exit 0
        ;;
    "stop")
        stop_services
        ;;
    "start")
        start_services
        ;;
    "restart")
        restart_services
        ;;
    "status")
        show_status
        ;;
    *)
        echo "Usage: $0 [start|stop|restart|status] [-v|--verbose]"
        echo "Use -h or --help for detailed usage information"
        exit 1
        ;;
esac
