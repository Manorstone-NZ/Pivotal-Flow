{
  "name": "@pivotalflow/frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "analyze": "npm run build && open dist/stats.html",
    "analyze:open": "open dist/stats.html",
    "analyze:build": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "perf:build": "pnpm build && node scripts/bundle-budget-check.js dist/stats.json",
    "perf:monitor": "node scripts/performance-monitor.js",
    "perf:budget": "node scripts/bundle-budget-check.js",
    "perf:report": "pnpm perf:monitor && pnpm perf:budget",
    "perf:ci": "pnpm build && pnpm perf:budget && pnpm perf:monitor"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@pivotal-flow/sdk": "workspace:^",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sinclair/typebox": "^0.34.41",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@playwright/test": "^1.40.0",
    "@storybook/addon-a11y": "^9.1.7",
    "@storybook/addon-docs": "^9.1.7",
    "@storybook/react-vite": "^9.1.7",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "eslint": "^9.10.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.1",
    "playwright": "^1.47.2",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "storybook": "^9.1.7",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^3.2.4",
    "eslint-plugin-storybook": "9.1.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
